# Variabili lette da Vite in tutte le build (anteprima GitHub Pages e server).

# Indirizzo base del backend dei consensi cookie (il sito chiama /consent/config e /consent;
# il backend riconosce il sito dall'origine e deve accettare richieste CORS da
# https://www.agenziaimpresa.com). Vuoto = scelte applicate ma non registrate.
VITE_CONSENT_API_URL=https://amosport.it

# Versione della Cookie Policy usata finché non arriva quella del backend (/consent/config):
# conviene tenerla uguale a quella configurata sul backend.
VITE_COOKIE_POLICY_VERSION=2026-10-13

# Chiave pubblica (site key) di Google reCAPTCHA v2 "Non sono un robot" per i moduli di contatto:
# è la stessa dei siti Gruppo APM, restainup e Remote Dental, verificata dal servizio EccoSolution.
# La chiave segreta NON va qui: la usa solo il servizio che invia le email. Vuoto = niente captcha.
VITE_RECAPTCHA_SITE_KEY=6Le7u28sAAAAAMc6TQbSEgr1h-Q52tY52_EA-vTS
